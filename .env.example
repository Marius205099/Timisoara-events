# ─── Ce Facem în Timișoara? — environment variables ───────────────────────────
# Copy to .env.local for local development. NEVER commit real values.

# Public site URL (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://cefacem-timisoara.vercel.app

# ── Database (Supabase Postgres + PostGIS) ─────────────────────────────────────
# Server-side only. Use the *Transaction pooler* connection string (port 6543).
# Leave empty to run locally on the embedded PostGIS database (demo mode).
DATABASE_URL=

# ── Admin authentication (Supabase Auth) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local/demo mode only (ignored when Supabase Auth is configured):
ADMIN_PASSWORD=

# ── Geofence ───────────────────────────────────────────────────────────────────
# Optional. Can only LOWER the radius; values above 50000 are capped at 50000.
# The authoritative value lives in the app_config table (also capped at 50 km).
GEOFENCE_MAX_METERS=50000

# ── AI enrichment (server-side only; optional) ────────────────────────────────
# Without a key, a deterministic rules-based classifier is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI_ENRICHMENT=off

# ── Geocoding ─────────────────────────────────────────────────────────────────
# Default: public OpenStreetMap Nominatim (1 request/second, cached in DB).
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Contact address sent in the From header, as Nominatim's usage policy asks.
NOMINATIM_EMAIL=

# ── Ingestion & scheduling ────────────────────────────────────────────────────
# Bearer token for GET /api/cron/ingest (external schedulers).
CRON_SECRET=
# Optional: lets the admin "Start ingestion" button dispatch the GitHub Actions worker.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=owner/ce-facem-timisoara
INGEST_MIN_DELAY_MS=1500
